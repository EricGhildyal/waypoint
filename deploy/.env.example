# Copy to deploy/.env on the VPS. Never commit the real file (§11).

# --- app -------------------------------------------------------------------
APP_URL=https://waypoint.ergh.co
AUTH_URL=https://waypoint.ergh.co/api/auth
# `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth (Web application credentials — see setup-steps.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte hex: `openssl rand -hex 32` — encrypts Secret rows at rest
MASTER_ENCRYPTION_KEY=
# comma-separated allowlist seeded on first boot (also editable in Settings)
SEED_ALLOWED_EMAILS=ericghildyal@gmail.com

# --- email (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=waypoint@waypoint.ergh.co
INBOUND_DOMAIN=waypoint.ergh.co

# --- agents ----------------------------------------------------------------
# seed only — thereafter rotated from Settings as an encrypted global Secret.
# From `claude setup-token` on your machine (Claude Max subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# used ONLY for GET /v1/models (model-list refresh); agent traffic runs on the
# Max OAuth token above.
# NOTE: deliberately NOT named ANTHROPIC_API_KEY — the Claude Code SDK picks
# that name up from the environment automatically and would bill agent runs to
# this API key instead of the Max subscription OAuth token.
MODEL_LOOKUP_ANTHROPIC_API_KEY=
# seeded into the global GIT_PAT Secret on first boot; per-project override via
# a project GIT_PAT secret
GITHUB_DEFAULT_PAT=
# optional — a bot account's token, seeded into the global GIT_BOT_PAT Secret on
# first boot. Waypoint then clones, pushes and opens PRs as the bot, so you can
# approve them (setup-steps.md §8a). Also settable later from Settings.
WAYPOINT_BOT_PAT=

# --- images ----------------------------------------------------------------
GHCR_USER=ericghildyal

# --- Docker inside tasks ---------------------------------------------------
# Projects with "Docker inside tasks" switched on run their own Docker daemon
# (for compose stacks). Left blank, those task containers run privileged, which
# is enough for an agent to reach this host. To avoid that, install an
# isolating runtime such as Sysbox and name it here (e.g. sysbox-runc).
RUNNER_DOCKER_RUNTIME=

# --- litestream → Hetzner Object Storage (S3 API) --------------------------
LITESTREAM_ENDPOINT=https://fsn1.your-objectstorage.com
LITESTREAM_REGION=fsn1
LITESTREAM_BUCKET=waypoint-litestream
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
