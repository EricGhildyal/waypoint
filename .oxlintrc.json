{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "apps/web/.next",
    "apps/web/next-env.d.ts",
    "packages/core/src/generated",
    ".make",
    ".local",
    "data"
  ],
  "rules": {
    // Unused vars are a typecheck-adjacent smell, but the `_`-prefix escape
    // hatch has to keep working for deliberately-ignored params.
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    // The services log to stdout by design (the orchestrator's tick, the
    // runner's stage output); only web should be quiet.
    "no-console": "off",
    // The runner and orchestrator await in loops on purpose: stages are
    // sequential, and the sync loop is rate-limited by design.
    "no-await-in-loop": "off",
    // `_private` fields are used deliberately across core.
    "no-underscore-dangle": "off",
    // Stylesheets are imported for their side effect — there is nothing to
    // assign. Every other bare import still has to justify itself.
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["react", "jsx-a11y", "nextjs"],
      "env": { "browser": true },
      "rules": {
        // Next 16 uses the automatic JSX runtime — importing React is not
        // required, and this rule assumes the classic transform.
        "react/react-in-jsx-scope": "off",
        // Wants `<output>` wherever role="status" appears, but `<output>` also
        // carries form-association semantics that a spinner shouldn't have.
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Config files and the seed run as scripts, not as app code.
      "files": ["**/*.config.{ts,js,mjs}", "packages/core/prisma/seed.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      // yup's conditional validation is `.when(key, { is, then })` — a `then`
      // key on a plain options object, not an accidental thenable.
      "files": [
        "apps/web/**/*-form.tsx",
        "apps/web/app/(app)/tasks/task-detail.tsx"
      ],
      "rules": { "unicorn/no-thenable": "off" }
    }
  ]
}
