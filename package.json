{
  "name": "waypoint",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:orchestrator": "bun run --cwd apps/orchestrator dev",
    "build:web": "bun run --cwd apps/web build",
    "db:generate": "bun run --cwd packages/core db:generate",
    "db:migrate:dev": "bun run --cwd packages/core db:migrate:dev",
    "db:migrate:deploy": "bun run --cwd packages/core db:migrate:deploy",
    "db:drift": "bun run --cwd packages/core db:drift",
    "db:seed": "bun run --cwd packages/core db:seed",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/orchestrator typecheck && bun run --cwd apps/runner typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "oxlint": "1.77.0",
    "prettier": "3.9.6"
  }
}
